# Buzz relay connection (required by `serve`; `acp` passes through to children)
BUZZ_RELAY_URL=wss://buzz.happyvertical.com
# Agent identity (nsec or hex). Keep the real value out of the repository.
BUZZ_PRIVATE_KEY=

# buzz-agent-prime runtime limits
BUZZ_AGENT_PRIME_MAX_SESSIONS=4
BUZZ_AGENT_PRIME_STATE_DIR=/var/lib/buzz-agent-prime
